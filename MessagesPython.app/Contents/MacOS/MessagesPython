#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
PROJECT_DIR="$(cd "$APP_DIR/.." && pwd)"
VENV_PY="$PROJECT_DIR/venv/bin/python"
APP_PY="$PROJECT_DIR/app.py"
LOG_FILE="$HOME/Library/Logs/MessagesPython.log"
export LOCAL_DIGEST_DEBUG=0
export LOCAL_DIGEST_RELOAD=0

if [ ! -x "$VENV_PY" ]; then
  echo "venv python not found at $VENV_PY" >&2
  exit 1
fi

if [ ! -f "$APP_PY" ]; then
  echo "app.py not found at $APP_PY" >&2
  exit 1
fi

cd "$PROJECT_DIR" || exit 1

# Kill any existing process on port 5001 and wait for port to be free
if lsof -ti :5001 >/dev/null 2>&1; then
  echo "$(date): Port 5001 is busy. Killing existing process..." >>"$LOG_FILE"

  # First try graceful shutdown via API
  curl -s -X POST "http://127.0.0.1:5001/api/shutdown" >/dev/null 2>&1
  sleep 0.5

  # If still running, use SIGTERM
  if lsof -ti :5001 >/dev/null 2>&1; then
    lsof -ti :5001 | xargs kill >/dev/null 2>&1
    sleep 1
  fi

  # If STILL running, force kill
  if lsof -ti :5001 >/dev/null 2>&1; then
    lsof -ti :5001 | xargs kill -9 >/dev/null 2>&1
    sleep 1
  fi

  # Wait for port to actually be free (up to 5 seconds)
  for i in {1..10}; do
    if ! lsof -ti :5001 >/dev/null 2>&1; then
      echo "$(date): Port 5001 is now free" >>"$LOG_FILE"
      break
    fi
    sleep 0.5
  done
fi

# Final check - if port still busy, exit with error
if lsof -ti :5001 >/dev/null 2>&1; then
  echo "$(date): ERROR - Could not free port 5001" >>"$LOG_FILE"
  osascript -e 'display notification "Could not free port 5001" with title "MessagesPython"'
  exit 1
fi

# Start browser opener in background (waits for server to be ready)
(
  for i in {1..30}; do
    if curl -s "http://127.0.0.1:5001/api/status" >/dev/null 2>&1; then
      open "http://127.0.0.1:5001"
      exit 0
    fi
    sleep 0.5
  done
  # Timeout - open anyway and let user see any error
  open "http://127.0.0.1:5001"
) &

# Start the Flask server
echo "$(date): Starting server..." >>"$LOG_FILE"
"$VENV_PY" "$APP_PY" >>"$LOG_FILE" 2>&1 &
SERVER_PID=$!

trap 'kill "$SERVER_PID" >/dev/null 2>&1 || true; exit 0' INT TERM

while kill -0 "$SERVER_PID" >/dev/null 2>&1; do
  sleep 1
done

echo "$(date): Server stopped" >>"$LOG_FILE"
